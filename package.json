{
  "name": "sac-call-archive",
  "version": "0.1.0",
  "private": true,
  "description": "Webhook receiver that archives CloudTalk call recordings to Google Drive",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "probe": "tsx src/probe.ts",
    "backfill": "tsx src/backfill.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
