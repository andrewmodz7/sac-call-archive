CLOUDTALK_API_KEY_ID=
CLOUDTALK_API_KEY_SECRET=
CLOUDTALK_WEBHOOK_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=    # full json blob, single line
DRIVE_ROOT_FOLDER_ID=           # drive folder id of "CloudTalk Recordings" (Jay and any other agent)
JOE_DRIVE_ROOT_FOLDER_ID=       # drive folder id for Joe's calls. separate root, NOT under DRIVE_ROOT_FOLDER_ID
PORT=3000
DB_PATH=data/calls.db           # optional. on railway point this at a mounted volume so dedup survives redeploys

# Daily reminder email (Mon-Fri 6:00 PM America/New_York).
# Without the two SMTP vars the scheduler does not start and nothing else is affected.
GMAIL_SMTP_USER=                # gmail address that sends the reminder. also used as the From
GMAIL_SMTP_APP_PASSWORD=        # gmail APP PASSWORD, not the account password. https://myaccount.google.com/apppasswords
JAY_DRIVE_FOLDER_ID=12Eudueh9u03gk2lFPYUWhh77GYQWJ6Of  # optional. jay's folder inside DRIVE_ROOT_FOLDER_ID, used as the email's jay link. unset falls back to the root
KENNETH_EMAIL=kdanna@shoreacrescapital.com          # optional. To: recipient, defaults to this if unset
ANDREW_EMAIL_CC=amodzelewski@shoreacrescapital.com  # optional. Cc: recipient, defaults to this if unset
JOE_EMAIL=                      # required before Joe's reminder ships. To: recipient for Joe's own daily summary, no default real address set
ADMIN_TRIGGER_TOKEN=            # optional. any random string. enables POST /admin/send-reminder and POST /admin/send-joe-reminder for manual test sends
